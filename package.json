{
  "name": "pingget",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.web.config.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "dev:all": "vite --config vite.web.config.ts",
    "dev:user": "vite --config vite.user.config.ts",
    "dev:dp": "vite --config vite.dp.config.ts",
    "dev:admin": "vite --config vite.admin.config.ts",
    "dev:parallel": "npx --yes concurrently -k -n user,dp,admin -c lime,cyan,magenta \"vite --config vite.user.config.ts --port 5173\" \"vite --config vite.dp.config.ts --port 5174\" \"vite --config vite.admin.config.ts --port 5175\"",
    "build": "npm run build:web",
    "build:web": "tsc -b && vite build --config vite.web.config.ts",
    "build:user": "tsc -b && vite build --config vite.user.config.ts",
    "build:dp": "tsc -b && vite build --config vite.dp.config.ts",
    "build:admin": "tsc -b && vite build --config vite.admin.config.ts",
    "build:all": "npm run build:web && npm run build:user && npm run build:dp && npm run build:admin",
    "preview": "vite preview --config vite.web.config.ts",
    "preview:web": "vite preview --config vite.web.config.ts",
    "preview:user": "vite preview --config vite.user.config.ts",
    "preview:dp": "vite preview --config vite.dp.config.ts",
    "preview:admin": "vite preview --config vite.admin.config.ts",
    "cap:sync:user": "npm run build:user && npx cap sync android",
    "cap:sync:dp": "npm run build:dp && CAPACITOR_CONFIG_FILE=capacitor.dp.config.ts npx cap sync android --config capacitor.dp.config.ts",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "build:android:user": "npm run build:user && npx cap sync android",
    "build:android:dp": "npm run build:dp && npx cap sync android --config capacitor.dp.config.ts",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^6.3.1",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.0.0",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/status-bar": "^6.0.0",
    "@hookform/resolvers": "^3.9.1",
    "@supabase/supabase-js": "^2.45.4",
    "firebase": "^10.14.1",
    "lucide-react": "^0.460.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
